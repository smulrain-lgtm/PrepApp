# Copy to server/.env on the Pi and fill in. Never commit .env.

# Hostname the devices use for sync. Create a DNS "A" record for it that points
# at the Pi's fixed address on the home network (e.g. 192.168.1.50).
SYNC_HOST=prep.mulras.uk

# The web app's origin (scheme + host, no path). CORS allows only this.
APP_ORIGIN=https://smulrain-lgtm.github.io

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# DNS provider for the certificate challenge: cloudflare or porkbun.
DNS_PROVIDER=cloudflare

# Cloudflare: an API token with Zone:DNS:Edit on mulras.uk only.
CLOUDFLARE_API_TOKEN=

# Porkbun: API key + secret, with API access enabled for mulras.uk.
PORKBUN_API_KEY=
PORKBUN_API_SECRET_KEY=

# CouchDB server admin (used only by the setup script on the Pi).
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# The household database and the single login every device uses to sync.
COUCHDB_DB=prepapp
COUCHDB_SYNC_USER=household
COUCHDB_SYNC_PASSWORD=
